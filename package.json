{
  "name": "react-example",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "start": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build --configLoader=native && node scripts/build-sw.mjs",
    "preview": "vite preview --configLoader=native",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/tests/offline-check.mjs && node scripts/tests/sw-offline.mjs",
    "lint": "tsc --noEmit && oxlint src scripts e2e",
    "clean": "rm -rf dist",
    "audit:mesh": "tsx --import ./scripts/loaders/raw.mjs scripts/audits/mesh-audit.ts",
    "audit:solid": "tsx --import ./scripts/loaders/raw.mjs scripts/audits/solid-audit.ts",
    "make:sample": "tsx --import ./scripts/loaders/raw.mjs scripts/make-sample.ts",
    "audit:reference": "vitest run --config vitest.audit.config.ts scripts/audits/reference.audit.ts",
    "audit:structural": "vitest run --config vitest.audit.config.ts",
    "test:exporters": "tsx --import ./scripts/loaders/raw.mjs scripts/tests/test-exporters.ts",
    "verify": "tsc --noEmit && npm test && npm run audit:hooks && npm run test:manual && npm run audit:solid",
    "test:manual": "tsx scripts/tests/manual-search.ts",
    "audit:hooks": "tsx scripts/audits/hooks-audit.ts",
    "test:ui": "node scripts/tests/ui/ui-shell.mjs && node scripts/tests/ui/ui-screens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts": "node scripts/copy-fonts.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "test:properties": "vitest run --config vitest.validation.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "regenerator-runtime": "^0.14.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
