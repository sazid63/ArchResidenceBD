{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/server.ts",
    "start": "tsx src/server/server.ts",
    "build": "vite build --configLoader=native",
    "preview": "vite preview --configLoader=native",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:mesh": "tsx scripts/audits/mesh-audit.ts",
    "audit:solid": "tsx scripts/audits/solid-audit.ts",
    "audit:presets": "tsx scripts/audits/preset-audit.ts",
    "audit:structural": "tsx scripts/audits/structural-sweep.ts",
    "audit:full": "tsx scripts/audits/full-audit.ts",
    "test:floorplan": "tsx scripts/tests/floorplan-chain.ts",
    "test:exporters": "tsx scripts/tests/test-exporters.ts",
    "verify": "tsc --noEmit && npm run test:floorplan && npm run audit:solid && npm run audit:presets"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
