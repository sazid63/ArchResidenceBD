{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/structure/section.ts",
    "src/structure/footing.ts",
    "src/structure/seismic.ts",
    "src/structure/column.ts",
    "src/structure/anchorage.ts",
    "src/model/migrate.ts"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 60
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "ignoreStatic": true,
  "inPlace": true,
  "dryRunTimeoutMinutes": 10
}
